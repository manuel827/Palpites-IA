# =============================================================================
# SOCCER-PALPITES — variáveis de ambiente
# =============================================================================
# Deploy: Cloudflare Workers. Para desenvolvimento local, copie este arquivo
# para ".dev.vars" (mesmo formato dotenv) — é o que o `wrangler`/
# `@cloudflare/vite-plugin` lê para simular as variáveis do Worker.
# Em produção, estas variáveis NÃO vêm de um arquivo: configure-as em
# Cloudflare Dashboard → Workers & Pages → soccer-palpites → Settings →
# Variables and Secrets. Use tipo "Secret" (não "Text") para as sensíveis —
# SUPABASE_SERVICE_ROLE_KEY, ADMIN_SECRET_KEY, SESSION_SECRET — ou:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# NENHUMA destas variáveis tem prefixo VITE_ — nenhuma delas é enviada ao
# navegador. Todas só existem no lado do servidor (loaders, actions,
# entry.server.tsx), populadas via process.env graças à flag nodejs_compat
# em wrangler.jsonc.

# --- Supabase --------------------------------------------------------------
# URL do projeto Supabase (painel do projeto > Project Settings > API).
SUPABASE_URL=https://wlzblbsdfjoceaigsrmq.supabase.co

# Chave "anon" pública do Supabase. Mesmo sendo "pública" por design do
# Supabase, aqui ela só é usada no servidor (dentro dos loaders), nunca no
# navegador — as políticas de RLS são a camada real de proteção para ela.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndsemJsYnNkZmpvY2VhaWdzcm1xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc2NTMwODQsImV4cCI6MjEwMzIyOTA4NH0.GAs9FqHlHrJi-1NTfqDbPUVd1WSa4AUSzpYLpgTneew

# Chave "service_role". PODER TOTAL sobre o banco — ignora RLS. Usada
# SOMENTE dentro de rotas /admin já autenticadas. Nunca deve aparecer em
# nenhum arquivo carregado pelo navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndsemJsYnNkZmpvY2VhaWdzcm1xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzY1MzA4NCwiZXhwIjoyMTAzMjI5MDg0fQ.e8jSMgkS2CAbCn-Aqj1Toc1pGiurULP9uTE_U4iruk8

# --- Administração -----------------------------------------------------------
# Chave secreta para autenticar no painel /admin. Gere uma chave forte e
# aleatória em produção, por exemplo com:
#   openssl rand -base64 32
ADMIN_SECRET_KEY=VcCSAWvUXzTt4X3uif2Ivewp4SVYc+nZ3cb91Eu2JTQ=

# Segredo usado para assinar o cookie de sessão administrativa. Gere com:
#   openssl rand -base64 32
SESSION_SECRET=Pbgo3LICk1gfvP7QH8dMzRtcS0c3qAqfs4vBfZM0iQ0=

# --- Site --------------------------------------------------------------------
# URL pública e final do site, sem barra final. Usada para gerar canonical,
# Open Graph, JSON-LD e sitemap.xml.
SITE_URL=https://soccer-palpites.mwq073.workers.dev

# --- SEO / Google Search Console ---------------------------------------------
# Código de verificação de propriedade do Google Search Console
# (meta tag "google-site-verification"). Ver README para o passo a passo.
GOOGLE_SITE_VERIFICATION=
